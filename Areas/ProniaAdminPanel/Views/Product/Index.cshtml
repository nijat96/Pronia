@using Pronia.Areas.ProniaAdminPanel.ViewModels.Product
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model List<ProductsVM>


<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <p class="card-title">Products</p>
                <a asp-area="ProniaAdminPanel" asp-controller="Product" asp-action="Create" class="btn btn-success">Create Product</a>
            </div>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>
                                Main Image
                            </th>
                            <th>
                                Name
                            </th>
                            <th>
                                Category
                            </th>
                            <th>
                                Price
                            </th>
                            <th>
                                Update
                            </th>
                            <th>
                                Actions
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model)
                        {
                            <tr>
                                <td class="py-1">
                                    <img src="~/assets/images/website-images/@product.MainImageUrl" alt="image" />
                                </td>
                                <td>
                                    @product.Name
                                </td>

                                <td>
                                    @product.CategoryName
                                </td>
                                <td>
                                    @product.Price
                                </td>

                                <td>
                                    <a asp-area="ProniaAdminPanel" asp-controller="Product" asp-action="Update" asp-route-id="@product.Id" class="btn btn-primary">Update</a>
                                </td>
                                <td>
                                    @if (product.IsDeleted)
                                    {
                                        <a asp-area="ProniaAdminPanel" asp-controller="Product" asp-action="Restore" asp-route-id="@product.Id" class="btn btn-success">Restore</a>
                                    }
                                    else
                                    {
                                        <a asp-area="ProniaAdminPanel" asp-controller="Product" asp-action="Delete" asp-route-id="@product.Id" class="btn btn-danger">Delete</a>
                                    }

                                </td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
