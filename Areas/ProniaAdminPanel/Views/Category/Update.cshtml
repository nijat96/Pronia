@using Pronia.Areas.ProniaAdminPanel.ViewModels.Category
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model UpdateCategoryVM

<div class="content-wrapper">
    <div class="row">
        <div class="col-12 grid-margin stretch-card">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Basic form elements</h4>
                    <p class="card-description">
                        Basic form elements
                    </p>
                    <form class="forms-sample" asp-area="ProniaAdminPanel" asp-controller="Category" asp-action="Update" enctype="multipart/form-data" method="post">
                        <input type="hidden" asp-for="Id" value="@Model.Id" />
                        <div class="form-group">
                            <label for="Name">Name</label>
                            <input class="form-control" placeholder="Category Name" asp-for="Name">
                            <span asp-validation-for="Name"></span>
                        </div>
                        <button type="submit" class="btn btn-primary me-2">Submit</button>
                        <button asp-area="ProniaAdminPanel" asp-controller="Category" asp-action="Categories" class="btn btn-light">Cancel</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
