@{
}
@model Pronia.Entities.Category

        <div class="content-wrapper">
          <div class="row">
            <div class="col-12 grid-margin stretch-card">
              <div class="card">
                <div class="card-body">
                  <h4 class="card-title">Basic form elements</h4>
                  <p class="card-description">
                    Basic form elements
                  </p>
                    <form class="forms-sample" asp-area="ProniaAdminPanel" asp-controller="Category" asp-action="Create" enctype="multipart/form-data" method="post">
                    <div class="form-group">
                      <label for="InputName">Name</label>
                      <input type="text" class="form-control" id="InputName" placeholder="Category Name" asp-for="Name">
                    </div>
                    <button type="submit" class="btn btn-primary me-2">Submit</button>
                    <button asp-area="ProniaAdminPanel" asp-controller="Category" asp-action="Categories" class="btn btn-light">Cancel</button>
                  </form>
                </div>
              </div>
            </div>
          </div>
        </div>
